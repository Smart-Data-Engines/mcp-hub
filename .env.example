# Copy to .env. Generate secrets locally; never commit .env.
ENVIRONMENT=production
HUB_PUBLIC_URL=https://mcp.example.com
STORE_URL=redis://:REPLACE_WITH_RANDOM_PASSWORD@store:6379/0
STORE_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CREDENTIALS_ENCRYPTION_KEY=GENERATE_WITH_python_-c_from_cryptography.fernet_import_Fernet
HUB_REGISTRATION_SECRET=REPLACE_WITH_RANDOM_SECRET
HUB_UPSTREAM_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Company sign-in: google | entra | keycloak | okta | auth0 | gitlab | oidc.
# All use verified OIDC discovery; the provider name selects the callback URL.
IDP_PROVIDER=oidc
IDP_ISSUER=https://identity.example.com/realms/company
IDP_CLIENT_ID=mcp-hub
IDP_CLIENT_SECRET=REPLACE_WITH_IDP_APPLICATION_SECRET
IDP_TOKEN_AUTH_METHOD=client_secret_post
IDP_USERNAME_CLAIM=preferred_username
IDP_SCOPES=openid profile email
IDP_ALLOWED_DOMAINS=
# Optional authoritative administrator list; only verified OIDC email claims qualify.
# When set, the console cannot add/remove administrators.
ADMIN_EMAILS=
# Optional internal URL for an operator-controlled reverse proxy to the same IdP.
IDP_BACKCHANNEL_URL=
HUB_CA_BUNDLE=
HUB_HTTP_PROXY=

# Upstream source repository (separate from the gateway repository).
REGISTRY_BACKEND=github
# Use git for Bitbucket or another SSH Git host; mount the key and known_hosts read-only.
REGISTRY_REPOSITORY=your-organization/mcp-servers
REGISTRY_BRANCH=main
REGISTRY_GIT_REMOTE=
REGISTRY_SSH_KEY=
REGISTRY_KNOWN_HOSTS=
REGISTRY_TOKEN=
# Enable when the deployment key can read source but cannot push commits.
REGISTRY_READ_ONLY=false

# Docker runtime: see docs/deployment.md for ingress binding and isolation checks.
ENABLE_SELF_SERVICE=false
HUB_BIND_HOST=hub-control
TRUSTED_PROXY_IPS=
RUNTIME_HUB_CONTAINER=mcp-hub
RUNTIME_IMAGE=mcp-hub-upstream:local
RUNTIME_HOST_SOURCE_ROOT=/absolute/path/to/mcp-hub/.local/servers
REGISTRY_HOST_ROOT=/absolute/path/to/mcp-hub/.local/registry
HUB_UID=10001
HUB_GID=10001
DOCKER_GID=REPLACE_WITH_SOCKET_GROUP_ID
NETWORK_STATE=mcp-hub-state
NETWORK_INGRESS=mcp-hub-ingress
NETWORK_UPSTREAM_PREFIX=mcp-hub-upstream-

# Optional Elasticsearch/OpenSearch-compatible audit sink. Without it, events
# remain in a bounded durable Redis outbox and a warning is logged.
AUDIT_SINK_URL=
AUDIT_SINK_USER=
AUDIT_SINK_PASSWORD=
AUDIT_SPOOL_MAX_ENTRIES=10000
AUDIT_RETENTION_DAYS=30
CATALOG_REFRESH_INTERVAL=30
REGISTRY_RECONCILE_INTERVAL=15
HEARTBEAT_INTERVAL=60
UPSTREAM_LIST_TOOLS_TIMEOUT=2
UPSTREAM_CALL_TOOL_TIMEOUT=600
SESSION_READ_TIMEOUT=90
HUB_TOOL_RATE_LIMIT=300
HUB_TOOL_RATE_WINDOW=60
HUB_DAILY_CALL_BUDGET=0
MAX_RESPONSE_CHARS=65536
MAX_UPSTREAM_RESPONSE_BYTES=8388608
MAX_UPSTREAM_TOOLS=2000
ACCESS_TOKEN_TTL=2592000
REFRESH_TOKEN_TTL=7776000
SHUTDOWN_GRACE_PERIOD=30
IDEMPOTENCY_TTL=600
HUB_ANONYMOUS_ENABLED=false
HUB_PROVENANCE_FOOTER=true
# Literal matches, not regex: avoids regular-expression denial of service.
GUARDRAIL_RULES=[]
OTEL_EXPORTER_OTLP_ENDPOINT=
