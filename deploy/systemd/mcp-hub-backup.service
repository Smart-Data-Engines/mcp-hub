[Unit]
Description=MCP Hub backup
StartLimitIntervalSec=10min
StartLimitBurst=3
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/lib/mcp-hub/operations.py backup
TimeoutStartSec=40min
Restart=on-failure
RestartSec=60s
MemoryMax=1G
TasksMax=128
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/mcp-hub/shared/operations /srv/mcp-hub/shared/audit-snapshots /var/cache/mcp-hub-restic /run/lock
