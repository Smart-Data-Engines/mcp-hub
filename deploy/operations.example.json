{
  "hub_container": "mcp-hub",
  "audit_container": "mcp-hub-audit",
  "hub_env": "/srv/mcp-hub/shared/hub.env",
  "current_release": "/srv/mcp-hub/current",
  "deployment_lock": "/run/lock/mcp-hub-deploy.lock",
  "restore_check": "/usr/local/lib/mcp-hub/restore_check.py",
  "redis_image": "redis:7.4-alpine",
  "audit_snapshot_dir": "/srv/mcp-hub/shared/audit-snapshots",
  "restic_environment": {
    "RESTIC_REPOSITORY": "/srv/mcp-hub/shared/operations/local-repository",
    "RESTIC_PASSWORD_FILE": "/etc/mcp-hub/restic-password",
    "RESTIC_CACHE_DIR": "/var/cache/mcp-hub-restic"
  }
}
